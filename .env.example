# Database: leave unset in development to use the embedded Postgres in ./.data/pg
DATABASE_URL=

# Auth: long random string (openssl rand -base64 32). Required in production.
AUTH_SECRET=

# Email (Resend). Unset in dev: emails & sign-in codes print to the server console.
RESEND_API_KEY=
EMAIL_FROM="Reverse Clinics <orders@reverseclinics.com>"

# Razorpay (use rzp_test_ keys for staging). Unset: online payment hidden, COD only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SITE_URL=http://localhost:3100

# Comma-separated emails that become admin (owner) when they sign in
ADMIN_EMAILS=

# Notifications + warehouse
TEAM_EMAIL=
PICKUP_PINCODE=
