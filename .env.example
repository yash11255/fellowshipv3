# Database: leave unset in development to use the embedded Postgres in ./.data/pg
DATABASE_URL=

# Auth: long random string (openssl rand -base64 32). Required in production.
AUTH_SECRET=

# Email (Resend). Unset in dev: emails & sign-in codes print to the server console.
RESEND_API_KEY=
EMAIL_FROM="Arthroscopy College <admissions@arthroscopycollege.com>"

# Razorpay (use rzp_test_ keys for staging). Unset: online payment hidden, COD only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SITE_URL=http://localhost:3200

# Comma-separated emails that become admin (owner) when they sign in
ADMIN_EMAILS=

# Notifications + warehouse
TEAM_EMAIL=

# Dummy checkout for testing. On by default outside production while Razorpay keys are empty; set to 1 to allow on a staging deploy.
PAYMENTS_TEST_MODE=

# Mail server (SMTP). Works with Google Workspace/Gmail (smtp.gmail.com:465 + app password), Zoho (smtp.zoho.in:465), Outlook, Hostinger etc.
# If SMTP_HOST is empty, RESEND_API_KEY is used; in development with neither, emails are shown in Admin → Emails and the console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

